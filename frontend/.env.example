# Where the FastAPI backend listens. Server-side only: next.config.ts rewrites
# /api/* to it, so the browser only ever talks to this app's own origin. That is
# what makes the httpOnly session cookie first-party — pointing the browser
# straight at the API makes it cross-site, and SameSite=Lax then drops the
# cookie on every request.
API_ORIGIN=http://127.0.0.1:8020

# The go2rtc player is embedded as an iframe from the relay itself, so this one
# genuinely is public and stays absolute.
NEXT_PUBLIC_GO2RTC_URL=http://localhost:1984

# NEXT_PUBLIC_API_TOKEN is gone. It was a single static bearer token, identical
# for every visitor and baked into the JavaScript bundle at build time, so
# anyone who opened devtools held full credentials for the tenant. Sign-in now
# issues a per-user httpOnly cookie. Treat any value that was ever set here as
# public: rotate API_TOKEN on the backend, or set LEGACY_API_TOKEN_ENABLED=false.
