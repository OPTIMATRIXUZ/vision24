# Generated by `python -m scripts.gen_env_example --write` — do not edit by hand.
# Every value here is the code default from backend/app/config.py.
# Secrets are intentionally blank.

# --- Core ---
ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://vision24:vision24@localhost:5435/vision24

# --- Object storage (MinIO) ---
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_SECURE=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_BUCKET=clips

# --- Streaming relay ---
GO2RTC_BASE_URL=http://localhost:1984
REPLAY_SOURCE=
REPLAY_RTSP_BASE=rtsp://127.0.0.1:8554
REPLAY_TARGET=rtsp://127.0.0.1:8554/cam1

# --- AI providers ---
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REASONING=false
LIVE_AI_PROVIDER=
LIVE_AI_MODEL=
CHAT_MAX_TOOL_ROUNDS=6
CHAT_MAX_HISTORY=24
CHAT_THINKING_BUDGET=0
CHAT_MAX_SESSIONS=200

# --- Text to speech (Apple Silicon only) ---
TTS_ENABLED=true
TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-0.6B-Base-4bit
TTS_VOICE=
TTS_MAX_CHARS=400
TTS_WARMUP=true

# --- Detection worker ---
WORKER_FPS=12
YOLO_DEVICE=mps
YOLO_MODEL=yolo11s.pt
YOLO_IMGSZ=960
YOLO_CONF=0.3
YOLO_HALF=true
YOLO_TRACKER=
MIN_TRACK_AGE_S=0.8
MOTION_GATE_ENABLED=true
MOTION_MIN_RATIO=0.003
MOTION_PIXEL_DELTA=25
RENDER_WORKERS=6

# --- Semantic search ---
CLIP_ENABLED=true
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Authentication ---
AUTH_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_RESET=true

# --- Filesystem ---
DATA_DIR=

# --- HTTP / logging ---
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_DIR=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- Misc ---
VIDEO_SOURCE=

# --- Other ---
DELIVERY_ENABLED=true
DELIVERY_MODEL=yolov8s-worldv2.pt
DELIVERY_CONF=0.02
DELIVERY_PROMPTS=cardboard box,plastic crate,bottle crate,tray of cans,sack,plastic bag,package
DELIVERY_KEYFRAMES=5
DELIVERY_MATCH_THRESHOLD=0.5
DELIVERY_MARGIN=0.03
DELIVERY_VLM_VERIFY=true
DELIVERY_VLM_MAX_TRIPS=10
POS_MATCH_WINDOW_S=30
POS_MIN_PRESENCE_S=20
POS_VLM_VERIFY=true
POS_VLM_CLEAR_CONFIDENCE=0.7
SAVINGS_AVG_CHECK=120000
SAVINGS_VALUE_PER_FLAGGED_TXN=150000
SAVINGS_AFTER_HOURS_VALUE=500000
SAVINGS_PACKAGE_VALUE=80000
SUBSCRIPTION_PRICE_MONTH=1500000
